---
import LiveBanner from "../components/LiveBanner.astro";
import PageFooter from "../components/PageFooter.astro";
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <title>Support a Cause — countdowns.co</title>
  <meta name="description" content="Sponsor Caribbean cultural events through countdowns.co — transparent partnership tiers supporting festivals, carnivals and marine conservation." />
  <style>.t-fr,.t-kr,.t-es{display:none}.lang-row{display:flex;align-items:center;gap:16px}.note-warning{font-size:12px;color:#999;margin-bottom:10px}.cta-block.cta-flush{margin-top:0}.cta-lead{color:#ddd}</style>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0f0f0f;
      color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .page { max-width: 860px; margin: 0 auto; padding: 48px 24px 80px; }

    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .site-title {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: #fff;
    }

    .back-link {
      font-size: 12px;
      color: #555;
      text-decoration: underline;
    }
    .back-link:hover { color: #999; }

    .lang-group {
      display: flex;
      gap: 4px;
      flex-shrink: 0;
    }

    .lang-btn {
      background: transparent;
      border: 1px solid #555;
      border-radius: 3px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.8px;
      padding: 4px 10px;
      color: #aaa;
      font-family: inherit;
      transition: all 0.15s;
    }
    .lang-btn:hover { border-color: #888; color: #eee; }
    .lang-btn.active { background: #1e3a5f; border-color: #2d6aa0; color: #7ec8e3; }

    .divider { border: none; border-top: 1px solid #2e2e2e; margin: 32px 0; }

    .gain-box {
      background: #0a0f1a;
      border: 1px solid #1e3a5f;
      border-radius: 6px;
      padding: 16px 20px;
      margin: 20px 0 0;
    }

    .gain-box strong {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #5a8fad;
      margin-bottom: 10px;
    }

    .gain-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .gain-list li {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 13px;
      color: #ccc;
    }

    .gain-check {
      color: #5eead4;
      flex-shrink: 0;
      font-weight: 700;
    }

    .tax-note {
      font-size: 12px;
      color: #5a8fad;
      margin-top: 4px;
    }

    .warning-box {
      background: #111;
      border: 1px solid #2e2e2e;
      border-radius: 6px;
      padding: 16px 20px;
      margin: 20px 0 0;
    }

    .warning-box strong {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #b45309;
      margin-bottom: 10px;
    }

    .warning-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .warning-list li {
      font-size: 11px;
      color: #666;
      background: #1a1a1a;
      border: 1px solid #333;
      border-radius: 3px;
      padding: 2px 8px;
    }

    h2 {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
    }

    p { color: #aaa; margin-bottom: 12px; }

    .steps {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin: 24px 0;
    }

    .step {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .step-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #1e3a5f;
      border: 1px solid #2d6aa0;
      color: #7ec8e3;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .step-body strong {
      display: block;
      color: #eee;
      margin-bottom: 2px;
      font-size: 13px;
    }

    .step-body span { color: #888; font-size: 12px; }

    .ngo-card {
      background: #111;
      border: 1px solid #2e2e2e;
      border-radius: 6px;
      padding: 20px;
      margin: 24px 0;
      display: flex;
      gap: 20px;
      align-items: flex-start;
    }

    .ngo-badge {
      background: #0d2a2a;
      border: 1px solid #065f46;
      color: #34d399;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: 3px;
      white-space: nowrap;
      margin-top: 3px;
      flex-shrink: 0;
    }

    .ngo-info strong {
      display: block;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px;
    }

    .ngo-info p { color: #888; font-size: 12px; margin-bottom: 8px; }

    .ngo-link {
      font-size: 12px;
      color: #7ec8e3;
      text-decoration: underline;
    }
    .ngo-link:hover { color: #b3e0f2; }

    .tiers {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin: 24px 0;
    }

    .tier {
      background: #111;
      border: 1px solid #2e2e2e;
      border-radius: 6px;
      padding: 18px;
    }

    /* Simulator */
    .simulator {
      background: #111;
      border: 1px solid #2e2e2e;
      border-radius: 6px;
      padding: 24px;
      margin: 24px 0;
    }

    .simulator-scope {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #5a8fad;
      background: #0a0f1a;
      border: 1px solid #1e3a5f;
      border-radius: 4px;
      padding: 4px 10px;
      margin-bottom: 20px;
    }

    .simulator-label {
      display: block;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #444;
      margin-bottom: 8px;
    }

    .amount-input-row {
      display: flex;
      align-items: center;
      gap: 8px;
      max-width: 220px;
      margin-bottom: 24px;
    }

    .amount-input-row span {
      font-size: 20px;
      font-weight: 700;
      color: #888;
    }

    #donationAmount {
      background: #1a1a1a;
      border: 1px solid #333;
      border-radius: 4px;
      color: #fff;
      font-family: inherit;
      font-size: 20px;
      font-weight: 700;
      padding: 8px 12px;
      outline: none;
      width: 100%;
      transition: border-color 0.15s;
    }
    #donationAmount:focus { border-color: #2d6aa0; }

    .simulator-result {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 20px;
    }

    .result-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 8px 0;
      border-top: 1px solid #1e1e1e;
      font-size: 13px;
      color: #888;
    }
    .result-row:first-child { border-top: none; }

    .result-row strong {
      color: #ccc;
      font-size: 15px;
    }

    .result-row-main {
      background: #0d2a1a;
      border: 1px solid #166534;
      border-radius: 4px;
      padding: 10px 12px;
      margin: 4px 0;
    }
    .result-row-main strong {
      color: #4ade80;
      font-size: 18px;
    }

    .simulator-tier-panel {
      display: none;
      border-top: 1px solid #1e1e1e;
      padding-top: 16px;
      margin-top: 4px;
    }
    .simulator-tier-panel.active { display: block; }

    .simulator-tier-panel ul {
      list-style: none;
      padding: 0;
      margin-top: 10px;
    }

    .simulator-tier-panel ul li {
      font-size: 12px;
      color: #888;
      padding: 3px 0;
      border-top: 1px solid #1e1e1e;
    }
    .simulator-tier-panel ul li:first-child { border-top: none; }

    .compare-note {
      font-size: 12px;
      color: #5a8fad;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #1e1e1e;
    }

    .simulator-disclaimer {
      font-size: 11px;
      color: #555;
      margin-top: 16px;
      margin-bottom: 0;
    }
    .simulator-disclaimer a { color: #5a8fad; text-decoration: underline; }

    .tier-name {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #7ec8e3;
      margin-bottom: 6px;
    }

    .tier-amount {
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }

    .tier-amount span {
      font-size: 13px;
      font-weight: 400;
      color: #555;
    }

    .tier ul {
      list-style: none;
      padding: 0;
    }

    .tier ul li {
      font-size: 12px;
      color: #888;
      padding: 3px 0;
      border-top: 1px solid #1e1e1e;
    }

    .tier ul li:first-child { border-top: none; }

    .cta-block {
      background: #111;
      border: 1px solid #2e2e2e;
      border-radius: 6px;
      padding: 20px;
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .cta-block p { margin: 0; color: #888; font-size: 13px; }

    .cta-btn {
      background: #1e3a5f;
      border: 1px solid #2d6aa0;
      color: #7ec8e3;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      padding: 8px 20px;
      border-radius: 4px;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s;
      flex-shrink: 0;
    }
    .cta-btn:hover { background: #254e7a; text-decoration: none; color: #b3e0f2; }

    .current-sponsors {
      margin-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .sponsor-card {
      display: flex;
      align-items: center;
      gap: 20px;
      background: #111;
      border: 1px solid #2e2e2e;
      border-radius: 6px;
      padding: 16px 20px;
      text-decoration: none;
      transition: border-color 0.15s;
    }
    .sponsor-card:hover { border-color: #444; text-decoration: none; }

    .sponsor-logo {
      background: #fff;
      border-radius: 4px;
      padding: 6px 10px;
      flex-shrink: 0;
    }
    .sponsor-logo img { height: 36px; display: block; }

    .sponsor-info strong {
      display: block;
      font-size: 13px;
      color: #eee;
      margin-bottom: 3px;
    }
    .sponsor-info p { font-size: 12px; color: #666; margin: 0; }

    .sponsor-tier-badge {
      margin-left: auto;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: 3px;
      background: #1e3a5f;
      color: #7ec8e3;
      border: 1px solid #2d6aa0;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .sponsor-slot-empty {
      border: 1px dashed #2e2e2e;
      border-radius: 6px;
      padding: 28px;
      text-align: center;
      color: #333;
      font-size: 12px;
    }
  </style>
</head>

<body>
<LiveBanner />
  <div class="page">

    <div class="header-row">
      <h1 class="site-title">
        <a href="/">Countdowns</a>
      </h1>
      <div class="lang-row">
        <a class="back-link" href="/">
          <span class="t-en">← Back</span>
          <span class="t-fr">← Retour</span>
          <span class="t-kr">← Retounen</span>
          <span class="t-es">← Volver</span>
        </a>
        <div class="lang-group">
          <button class="lang-btn" data-lang="en">EN</button>
          <button class="lang-btn" data-lang="fr">FR</button>
          <button class="lang-btn" data-lang="kr">KR</button>
          <button class="lang-btn" data-lang="es">ES</button>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <!-- Intro -->
    <h2>
      <span class="t-en">Support a cause, get visibility</span>
      <span class="t-fr">Soutenez une cause, gagnez en visibilité</span>
      <span class="t-kr">Sipote on koz, jwenn vizibilite</span>
      <span class="t-es">Apoya una causa, gana visibilidad</span>
    </h2>

    <p>
      <span class="t-en">countdowns.co offers visibility to brands and organizations that support causes protecting the Caribbean. No money goes to this site — 100% of donations go directly to the featured NGO.</span>
      <span class="t-fr">countdowns.co offre de la visibilité aux marques et organisations qui soutiennent des causes protégeant la Caraïbe. Aucun argent ne va à ce site — 100 % des dons vont directement à l'ONG partenaire.</span>
      <span class="t-kr">countdowns.co ofri vizibilite bay mak epi òganizasyon ki sipote koz pou pwoteje Karayib la. Okenn lajan pa ale nan sit la — 100% don ale dirèktèman bay NGO patnè a.</span>
      <span class="t-es">countdowns.co ofrece visibilidad a marcas y organizaciones que apoyan causas que protegen el Caribe. Ningún dinero va a este sitio — el 100% de las donaciones van directamente a la ONG destacada.</span>
    </p>

    <div class="gain-box">
      <strong>
        <span class="t-en">What you gain</span>
        <span class="t-fr">Ce que vous gagnez</span>
        <span class="t-kr">Sa ou genyen</span>
        <span class="t-es">Qué ganas</span>
      </strong>
      <ul class="gain-list">
        <li>
          <span class="gain-check">✓</span>
          <span>
            <span class="t-en">A genuine association, not an ad slot. We list a small, curated group of sponsors tied to a verified donation — not a numbers-driven ad network.</span>
            <span class="t-fr">Une association authentique, pas un simple encart publicitaire. Nous référençons un petit groupe de sponsors sélectionnés, chacun lié à un don vérifié — pas un réseau publicitaire fondé sur l'audience.</span>
            <span class="t-kr">Yon vré asosyasyon, pa yon senp espas piblisite. Nou lis yon ti gwoup sponsor chwazi, chak lye ak yon don verifye — pa yon rezo piblisite ki baze sou odyans.</span>
            <span class="t-es">Una asociación genuina, no un simple espacio publicitario. Listamos un grupo pequeño y seleccionado de patrocinadores, cada uno vinculado a una donación verificada — no una red publicitaria basada en audiencia.</span>
          </span>
        </li>
        <li>
          <span class="gain-check">✓</span>
          <span>
            <span class="t-en">A possible tax deduction. Corporate donations to eligible nonprofits like L'Asso-Mer may reduce your company's tax bill, depending on your country (e.g. France's <em>mécénat d'entreprise</em> regime). Ask L'Asso-Mer for your donation receipt.</span>
            <span class="t-fr">Une possible déduction fiscale. Les dons d'entreprise à des associations éligibles comme L'Asso-Mer peuvent réduire l'impôt de votre société, selon votre pays (régime du mécénat d'entreprise en France). Demandez votre reçu de don à L'Asso-Mer.</span>
            <span class="t-kr">Yon posib rediksyon taks. Don biznis bay asosyasyon elijib tankou L'Asso-Mer ka redwi taks konpayi ou a, selon peyi ou (rejim mesena antrepriz an Frans). Mande L'Asso-Mer resi don ou.</span>
            <span class="t-es">Una posible deducción fiscal. Las donaciones corporativas a organizaciones elegibles como L'Asso-Mer pueden reducir los impuestos de tu empresa, según tu país (régimen de mecenazgo empresarial en Francia). Pide a L'Asso-Mer tu comprobante de donación.</span>
          </span>
        </li>
        <li>
          <span class="gain-check">✓</span>
          <span>
            <span class="t-en">A dated, public record of commitment. Your support stays listed on this page for the full duration of your tier — not a one-off social post that disappears from feeds.</span>
            <span class="t-fr">Une trace publique et datée de votre engagement. Votre soutien reste affiché sur cette page pendant toute la durée de votre palier — pas une simple publication qui disparaît des fils d'actualité.</span>
            <span class="t-kr">Yon prèv piblik ak dat sou angajman ou. Sipò ou rete afiche sou paj sa a pandan tout dire nivo ou a — pa yon senp pòs ki disparèt nan fil aktyalite.</span>
            <span class="t-es">Un registro público y con fecha de tu compromiso. Tu apoyo permanece listado en esta página durante toda la duración de tu nivel — no una simple publicación que desaparece del feed.</span>
          </span>
        </li>
      </ul>
    </div>

    <hr class="divider" />

    <!-- How it works -->
    <h2>
      <span class="t-en">How it works</span>
      <span class="t-fr">Comment ça fonctionne</span>
      <span class="t-kr">Kouman sa mache</span>
      <span class="t-es">Cómo funciona</span>
    </h2>

    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-body">
          <strong>
            <span class="t-en">Choose a tier and donate</span>
            <span class="t-fr">Choisissez un palier et faites un don</span>
            <span class="t-kr">Chwazi on nivo epi fè on don</span>
            <span class="t-es">Elige un nivel y dona</span>
          </strong>
          <span>
            <span class="t-en">Make your donation directly to the featured NGO. Keep your proof of donation.</span>
            <span class="t-fr">Faites votre don directement à l'ONG partenaire. Gardez votre preuve de don.</span>
            <span class="t-kr">Fè don ou dirèktèman bay NGO a. Gade prèv don ou.</span>
            <span class="t-es">Haz tu donación directamente a la ONG destacada. Guarda tu comprobante.</span>
          </span>
          <div class="tax-note">
            <span class="t-en">💡 This donation may be tax-deductible for your company, depending on your country.</span>
            <span class="t-fr">💡 Ce don peut être déductible des impôts de votre entreprise, selon votre pays.</span>
            <span class="t-kr">💡 Don sa a ka dediktib nan taks konpayi ou, selon peyi ou.</span>
            <span class="t-es">💡 Esta donación puede ser deducible de impuestos para tu empresa, según tu país.</span>
          </div>
        </div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-body">
          <strong>
            <span class="t-en">Send the NGO your website link or logo</span>
            <span class="t-fr">Envoyez à l'ONG le lien de votre site ou votre logo</span>
            <span class="t-kr">Voye ONG a lyen sit ou a oswa logo a</span>
            <span class="t-es">Envía a la ONG el enlace de tu sitio web o tu logo</span>
          </strong>
          <span>
            <span class="t-en">countdowns.co never handles your donation receipt or company details — the NGO confirms your sponsorship with us directly once everything checks out.</span>
            <span class="t-fr">countdowns.co ne traite jamais votre reçu de don ni vos informations d'entreprise — l'ONG confirme votre sponsoring directement auprès de nous une fois tout vérifié.</span>
            <span class="t-kr">countdowns.co pa janm trete resi don ou oswa enfòmasyon konpayi ou — ONG a konfime sponsoring ou dirèkteman ak nou yon fwa tout bagay verifye.</span>
            <span class="t-es">countdowns.co nunca gestiona tu comprobante de donación ni los datos de tu empresa — la ONG confirma tu patrocinio directamente con nosotros una vez verificado todo.</span>
          </span>
        </div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-body">
          <strong>
            <span class="t-en">You will appears on the site</span>
            <span class="t-fr">Vous apparaitrez sur le site</span>
            <span class="t-kr">Ou ké parèt sou sit la</span>
            <span class="t-es">Tu aparece en el sitio</span>
          </strong>
          <span>
            <span class="t-en">Your brand or organization is listed on the main page for the duration of your tier.</span>
            <span class="t-fr">Votre marque ou organisation est affichée sur la page principale pendant la durée de votre palier.</span>
            <span class="t-kr">Mak ou, òganizasyon ou afiche sou paj prensipal la pandan dire nivo ou a.</span>
            <span class="t-es">Tu marca u organización aparece en la página principal durante el periodo de tu nivel.</span>
          </span>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <!-- Featured NGO -->
    <h2>
      <span class="t-en">Current cause</span>
      <span class="t-fr">Cause actuelle</span>
      <span class="t-kr">Koz aktyèl la</span>
      <span class="t-es">Causa actual</span>
    </h2>

    <div class="ngo-card">
      <span class="ngo-badge">NGO</span>
      <div class="ngo-info">
        <strong>L'Asso-Mer</strong>
        <p>
          <span class="t-en">Marine conservation nonprofit based in Martinique. Since 2016, they protect coral reefs, sea turtles and Caribbean marine heritage through science, restoration, and public education.</span>
          <span class="t-fr">Association de conservation marine basée en Martinique. Depuis 2016, ils protègent les récifs coralliens, les tortues marines et le patrimoine marin caribéen par la science, la restauration et la sensibilisation.</span>
          <span class="t-kr">Asosyasyon konsèvasyon maren sitye Matinik. Depi 2016, yo ka pwoteje koray, tòti maren epi patrimwàn maren Karayib la atravè siyans, restòrasyon epi edikasyon piblik.</span>
          <span class="t-es">ONG de conservación marina con sede en Martinica. Desde 2016 protegen los arrecifes de coral, las tortugas marinas y el patrimonio marino caribeño a través de la ciencia, la restauración y la educación.</span>
        </p>
