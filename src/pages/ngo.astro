---
import LiveBanner from "../components/LiveBanner.astro";
import PageFooter from "../components/PageFooter.astro";
import ngos from "../data/ngos.json";
import quizQuestions from "../data/quiz-questions.json";
const { ngo } = ngos;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <title>L'Asso-Mer — countdowns.co</title>
  <meta name="description" content="Meet L'Asso-Mer, the Caribbean marine conservation NGO supported by countdowns.co — its actions, community progress and how to contribute." />
  <style>.t-fr,.t-kr,.t-es{display:none}.ngo-cta{text-align:center;padding:8px 0 0}.ngo-cta-link{font-size:12px;color:#5a9a90;text-decoration:underline}</style>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0a0f0f;
      color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .page { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }

    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
    }

    .back-link { font-size: 12px; color: #999999; text-decoration: underline; }
    .back-link:hover { color: #999; }

    .lang-group { display: flex; gap: 4px; }
    .lang-btn {
      background: transparent;
      border: 1px solid #555;
      border-radius: 3px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.8px;
      padding: 4px 10px;
      color: #aaa;
      font-family: inherit;
      transition: all 0.15s;
    }
    .lang-btn:hover { border-color: #888; color: #eee; }
    .lang-btn.active { background: #0d2a2a; border-color: #0d9488; color: #5eead4; }

    /* Hero */
    .ngo-hero {
      display: flex;
      align-items: center;
      gap: 24px;
      background: #0a1a1a;
      border: 1px solid #0d3d35;
      border-radius: 8px;
      padding: 28px 32px;
      margin-bottom: 32px;
    }

    .ngo-logo-wrap {
      background: #fff;
      border-radius: 6px;
      padding: 8px 14px;
      flex-shrink: 0;
    }
    .ngo-logo-wrap img { height: 48px; display: block; }

    .ngo-badge {
      display: inline-block;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: 3px;
      background: #0d2a2a;
      color: #34d399;
      border: 1px solid #065f46;
      margin-bottom: 8px;
    }

    .ngo-name { font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 4px; }

    .ngo-tagline { font-size: 13px; color: #5eead4; }

    /* 3 key elements */
    .key-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }

    .key-card {
      background: #0f1a1a;
      border: 1px solid #1a3a3a;
      border-radius: 6px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .key-icon { font-size: 24px; margin-bottom: 10px; }
    .key-title { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .key-text { font-size: 12px; color: #7a9a9a; line-height: 1.6; }

    .key-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; text-align: left; }
    .key-list li { font-size: 12px; color: #7a9a9a; padding-left: 14px; position: relative; }
    .key-list li::before { content: '—'; position: absolute; left: 0; color: #0d9488; }

    .id-rows { display: flex; flex-direction: column; gap: 10px; width: 100%; }
    .id-row { display: flex; flex-direction: column; gap: 2px; align-items: center; }
    .id-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.7px; color: #5a9a90; }
    .id-value { font-size: 13px; color: #c0d8d8; }
    .id-link { color: #5eead4; text-decoration: none; }
    .id-link:hover { text-decoration: underline; }
    .id-social { display: flex; gap: 8px; margin-top: 4px; flex-wrap: wrap; justify-content: center; }
    .id-social-link { display: flex; align-items: center; gap: 5px; color: #5eead4; border: 1px solid #1a3a3a; border-radius: 4px; padding: 4px 10px; text-decoration: none; font-size: 11px; font-weight: 600; transition: all 0.15s; }
    .id-social-link:hover { border-color: #0d9488; background: #0a1a1a; text-decoration: none; }
    .id-social-link svg { flex-shrink: 0; }

    /* Divider */
    .divider { border: none; border-top: 1px solid #1a2e2e; margin: 32px 0; }

    /* The Fight */
    .fight-header { display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom: 6px; }
    .fight-sub { font-size: 12px; color: #5a9a90; margin-bottom: 18px; }
    .fight-countdown-wrap { display:flex; align-items:center; justify-content:center; gap:10px; background: #0a1a1a; border: 1px solid #0d3d35; border-radius: 6px; padding: 12px; margin-bottom: 20px; }
    .fight-countdown-label { font-size: 11px; color: #5a9a90; text-transform: uppercase; letter-spacing: 0.5px; }
    .fight-countdown-time { font-size: 18px; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
    .fight-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px; }
    @media (max-width: 480px) { .fight-grid { grid-template-columns: 1fr; } }
    .fight-card { background: #0a1a1a; border: 1px solid #1a3a3a; border-radius: 8px; padding: 16px; }
    .fight-card.leading { border-color: #34d399; box-shadow: 0 0 0 1px #34d399 inset; }
    .fight-side-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #e0e0e0; margin-bottom: 10px; }
    .fight-amount { font-size: 22px; font-weight: 700; color: #34d399; font-variant-numeric: tabular-nums; }
    .fight-goal { font-size: 12px; color: #7a9a9a; font-weight: 400; }
    .fight-gauge-track { background: #0f2a2a; border-radius: 9px; height: 10px; overflow: hidden; margin: 10px 0 8px; }
    .fight-gauge-fill { height: 100%; border-radius: 9px; background: linear-gradient(90deg, #0d9488, #34d399); width: 0%; transition: width 0.4s ease; }
    .fight-meta { font-size: 11px; color: #5a9a90; }
    .fight-report-cta { display:flex; align-items:center; justify-content:space-between; gap: 12px; flex-wrap: wrap; background: #0a1a1a; border: 1px solid #0d3d35; border-radius: 8px; padding: 16px; margin-bottom: 20px; }
    .fight-report-cta p { margin:0; font-size:13px; color: #7a9a9a; flex:1; min-width:180px; }
    .btn-report { background: #0d9488; color: #06201c; font-weight: 700; font-size: 13px; border: none; border-radius: 5px; padding: 10px 18px; cursor: pointer; white-space: nowrap; }
    #fight-form { display:none; flex-direction:column; gap:10px; background: #0a1a1a; border: 1px solid #0d3d35; border-radius: 8px; padding: 16px; margin-bottom: 20px; }
    #fight-form.visible { display:flex; }
    #fight-form label { font-size: 11px; color: #5a9a90; text-transform: uppercase; letter-spacing: 0.5px; }
    #fight-form > div:not(.fight-side-choice) { display:flex; flex-direction:column; gap: 6px; }
    #fight-form input, #fight-form textarea { background: #1a1a1a; border: 1px solid #333; border-radius: 4px; color: #fff; font-family: inherit; font-size: 13px; padding: 8px 10px; width: 100%; }
    #fight-form .fight-side-choice { display:flex; gap: 14px; font-size: 13px; color: #e0e0e0; }
    #fight-form button[type=submit] { background: #0d9488; color: #06201c; font-weight: 700; border: none; border-radius: 5px; padding: 10px; cursor: pointer; }
    .fight-form-msg { font-size: 12px; }
    .fight-form-msg.visible { color: #34d399; }
    .fight-form-msg.visible.error { color: #f0a0a0; }
    .fight-history-title { font-size: 13px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
    .fight-history-row { display:flex; align-items:center; justify-content:space-between; gap:10px; background: #0a1a1a; border: 1px solid #1a3a3a; border-radius: 6px; padding: 10px 14px; font-size: 12px; margin-bottom: 8px; }
    .quiz-accordion { background: #0a1a1a; border: 1px solid #1a3a3a; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
    .quiz-accordion summary { padding: 14px 16px; font-size: 13px; font-weight: 700; color: #fff; cursor: pointer; list-style: none; }
    .quiz-accordion summary::-webkit-details-marker { display:none; }

    /* Quiz CTA */
    .quiz-cta {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 32px;
      align-items: center;
    }

    .btn-quiz {
      background: #0c6f66;
      border: none;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      padding: 10px 24px;
      border-radius: 4px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.15s;
    }
    .btn-quiz:hover { background: #0f766e; }
    .btn-quiz:disabled { background: #1a3a3a; color: #5a9a90; cursor: default; }

    .btn-donate {
      background: transparent;
      border: 1px solid #0d9488;
      color: #5eead4;
      font-size: 12px;
      font-weight: 700;
      padding: 10px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s;
      text-decoration: none;
      display: inline-block;
    }
    .btn-donate:hover { background: #0a1a1a; text-decoration: none; }

    /* Quiz section */
    #quiz-section { display: none; }
    #quiz-section.visible { display: block; }

    .quiz-box {
      background: #0f1a1a;
      border: 1px solid #1a3a3a;
      border-radius: 6px;
      padding: 24px;
      margin-bottom: 20px;
    }

    .quiz-progress {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .quiz-step { font-size: 11px; color: #5a9a90; text-transform: uppercase; letter-spacing: 0.6px; }
    .quiz-dots { display: flex; gap: 4px; }
    .quiz-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #1a3a3a;
      transition: background 0.2s;
    }
    .quiz-dot.active { background: #0d9488; }
    .quiz-dot.done { background: #34d399; }

    .quiz-question {
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .quiz-options { display: flex; flex-direction: column; gap: 16px; }

    .quiz-option {
      -webkit-appearance: none;
      appearance: none;
      background: #0d1f1f;
      border: 2px solid #1a3a3a;
      border-radius: 8px;
      padding: 20px 24px;
      cursor: pointer;
      font-size: 15px;
      line-height: 1.5;
      color: #ccc;
      text-align: left;
      font-family: inherit;
      transition: border-color 0.15s, background 0.15s, color 0.15s;
      width: 100%;
      min-height: 64px;
      display: flex;
      align-items: center;
      box-shadow: none;
    }
    .quiz-option:hover:not(:disabled) { border-color: #0d9488; color: #fff; background: #0f2a2a; }
    .quiz-option:active:not(:disabled) { transform: scale(0.985); }
    .quiz-option.correct { background: #052e1a; border-color: #34d399; color: #34d399; border-width: 2px; }
    .quiz-option.wrong { background: #1f0808; border-color: #f87171; color: #f87171; border-width: 2px; }
    .quiz-option:disabled { cursor: default; }
    .quiz-option:disabled:not(.correct):not(.wrong) { opacity: 0.5; }

    .quiz-feedback {
      margin-top: 14px;
      font-size: 12px;
      color: #5eead4;
      display: none;
      padding: 10px 14px;
      background: #050f0d;
      border-radius: 4px;
      border: 1px solid #065f46;
    }
    .quiz-feedback.wrong-fb { color: #f87171; background: #150505; border-color: #5f1a1a; }
    .quiz-feedback.visible { display: block; }

    .quiz-next {
      display: none;
      margin-top: 14px;
      background: transparent;
      border: 1px solid #0d9488;
      color: #5eead4;
      padding: 8px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 12px;
      font-family: inherit;
      transition: all 0.15s;
    }
    .quiz-next:hover { background: #0a1a1a; }
    .quiz-next.visible { display: inline-block; }

    /* Result */
    #quiz-result { display: none; }
    #quiz-result.visible { display: block; }

    .result-box {
      background: #050f0d;
      border: 1px solid #065f46;
      border-radius: 6px;
      padding: 28px;
      text-align: center;
      margin-bottom: 20px;
    }

    .result-score { font-size: 36px; font-weight: 700; color: #34d399; margin-bottom: 8px; }
    .result-label { font-size: 13px; color: #5eead4; margin-bottom: 8px; }
    .result-round-label { font-size: 12px; color: #4a7a70; margin-bottom: 20px; }
    .result-contribution {
      display: inline-block;
      background: #0a1a1a;
      border: 1px solid #0d9488;
      border-radius: 4px;
      padding: 8px 20px;
      font-size: 13px;
      color: #5eead4;
      margin-bottom: 20px;
    }

    .result-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    .btn-replay {
      background: transparent;
      border: 1px solid #1a3a3a;
      color: #aaa;
      padding: 8px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 12px;
      font-family: inherit;
      transition: all 0.15s;
    }
    .btn-replay:hover { border-color: #555; color: #eee; }

    /* Mission accomplished */
    #mission-accomplished { display: none; }
    #mission-accomplished.visible { display: block; }

    .mission-box {
      background: #052e1a;
      border: 1px solid #065f46;
      border-radius: 8px;
      padding: 32px;
      text-align: center;
      margin-bottom: 20px;
    }

    .mission-icon { font-size: 40px; margin-bottom: 12px; }
    .mission-title { font-size: 20px; font-weight: 700; color: #34d399; margin-bottom: 8px; }
    .mission-text { font-size: 13px; color: #5eead4; }

    @media (max-width: 600px) {
      .ngo-hero { flex-direction: column; align-items: flex-start; }
    }
  </style>
  <style is:global>
    /* Quiz elements created dynamically by ngo.js — must be global to receive styles */
    .quiz-dot { width: 8px; height: 8px; border-radius: 50%; background: #1a3a3a; transition: background 0.2s; }
    .quiz-dot.active { background: #0d9488; }
    .quiz-dot.done { background: #34d399; }

    .quiz-option {
      -webkit-appearance: none;
      appearance: none;
      background: #0d1f1f;
      border: 2px solid #1a3a3a;
      border-radius: 10px;
      padding: 0;
      cursor: pointer;
      font-size: 15px;
      line-height: 1.4;
      color: #ccc;
      text-align: left;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      transition: border-color 0.15s, background 0.15s, color 0.15s;
      width: 100%;
      display: flex;
      align-items: stretch;
      overflow: hidden;
    }
    .opt-letter {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 52px;
      flex-shrink: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #5a9a90;
      border-right: 1px solid #1a3a3a;
      transition: color 0.15s, border-color 0.15s;
    }
    .opt-text {
      flex: 1;
      padding: 18px 20px;
      display: flex;
      align-items: center;
    }
    .quiz-option:hover:not(:disabled) { border-color: #0d9488; background: #0f2a2a; color: #fff; }
    .quiz-option:hover:not(:disabled) .opt-letter { color: #5eead4; border-right-color: #0d9488; }
    .quiz-option:active:not(:disabled) { transform: scale(0.99); }
    .quiz-option.correct { background: #052e1a; border-color: #34d399; color: #34d399; }
    .quiz-option.correct .opt-letter { color: #34d399; border-right-color: #34d399; }
    .quiz-option.wrong { background: #1f0808; border-color: #f87171; color: #f87171; }
    .quiz-option.wrong .opt-letter { color: #f87171; border-right-color: #f87171; }
    .quiz-option:disabled { cursor: default; }
    .quiz-option:disabled:not(.correct):not(.wrong) { opacity: 0.4; }
  </style>
</head>
<body>
<LiveBanner />
<main class="page">

  <!-- Header -->
  <div class="header-row">
    <a class="back-link" href="/">
      <span class="t-en">← Back</span>
      <span class="t-fr">← Retour</span>
      <span class="t-kr">← Retounen</span>
      <span class="t-es">← Volver</span>
    </a>
    <div class="lang-group">
      <button class="lang-btn" data-lang="en" title="English">🇬🇧</button>
      <button class="lang-btn" data-lang="kr" title="Kréyol">🇭🇹</button>
      <button class="lang-btn" data-lang="fr" title="Français">🇫🇷</button>
      <button class="lang-btn" data-lang="es" title="Español">🇪🇸</button>
    </div>
  </div>

  <!-- NGO Hero -->
  <div class="ngo-hero">
    <div class="ngo-logo-wrap">
      <img src={ngo.logo} alt={ngo.name} height="48" />
    </div>
    <div>
      <div class="ngo-badge">
        <span class="t-en">Featured NGO</span>
        <span class="t-fr">ONG partenaire</span>
        <span class="t-kr">ONG patnè</span>
        <span class="t-es">ONG destacada</span>
      </div>
      <h1 class="ngo-name">L'Asso-Mer</h1>
      <div class="ngo-tagline">
        <span class="t-en">Protecting Caribbean marine ecosystems</span>
        <span class="t-fr">Protection des écosystèmes marins de la Caraïbe</span>
        <span class="t-kr">Pwoteksyon ekosistèm maren Karayib la</span>
        <span class="t-es">Protección de ecosistemas marinos del Caribe</span>
      </div>
    </div>
  </div>

  <!-- 3 Key Elements -->
  <div class="key-grid">

    <div class="key-card">
      <div class="key-icon">🪪</div>
      <div class="key-title">
        <span class="t-en">ID</span>
        <span class="t-fr">Identité</span>
        <span class="t-kr">Idantite</span>
        <span class="t-es">Identidad</span>
      </div>
      <div class="id-rows">
        <div class="id-row">
          <span class="id-label">
            <span class="t-en">Founded</span>
            <span class="t-fr">Fondée en</span>
            <span class="t-kr">Fonde an</span>
            <span class="t-es">Fundada en</span>
          </span>
          <span class="id-value">{ngo.founded}</span>
        </div>
        <div class="id-row">
          <span class="id-label">
            <span class="t-en">Location</span>
            <span class="t-fr">Localisation</span>
            <span class="t-kr">Kote</span>
            <span class="t-es">Ubicación</span>
          </span>
          <span class="id-value">📍 {ngo.location}</span>
        </div>
        <div class="id-row">
          <span class="id-label">
            <span class="t-en">Volunteers</span>
            <span class="t-fr">Bénévoles</span>
            <span class="t-kr">Benevol</span>
            <span class="t-es">Voluntarios</span>
          </span>
          <span class="id-value">🙋 {ngo.volunteers}</span>
        </div>
      </div>
    </div>

    <div class="key-card">
      <div class="key-icon">🐢</div>
      <div class="key-title">
        <span class="t-en">Actions</span>
        <span class="t-fr">Actions</span>
        <span class="t-kr">Aksyon</span>
        <span class="t-es">Acciones</span>
      </div>
      <ul class="key-list">
        <li>
          <span class="t-en">Sea turtle nesting surveys</span>
          <span class="t-fr">Suivis des nids de tortues marines</span>
          <span class="t-kr">Sondaj nich tòti maren</span>
          <span class="t-es">Seguimiento de nidos de tortugas marinas</span>
        </li>
        <li>
          <span class="t-en">Reef health assessments</span>
          <span class="t-fr">Évaluations de la santé des récifs</span>
          <span class="t-kr">Evalyasyon sante rekif</span>
          <span class="t-es">Evaluaciones de salud arrecifal</span>
        </li>
        <li>
          <span class="t-en">Plastic pollution cleanups</span>
          <span class="t-fr">Nettoyages des plastiques</span>
          <span class="t-kr">Netwayaj plastik</span>
          <span class="t-es">Limpiezas de plásticos</span>
        </li>
        <li>
          <span class="t-en">Environmental education for local communities</span>
          <span class="t-fr">Éducation environnementale des communautés locales</span>
          <span class="t-kr">Edikasyon anviwonmantal pou kominote lokal yo</span>
          <span class="t-es">Educación ambiental para comunidades locales</span>
        </li>
      </ul>
    </div>

    <div class="key-card">
      <div class="key-icon">📬</div>
      <div class="key-title">
        <span class="t-en">Contact</span>
        <span class="t-fr">Contact</span>
        <span class="t-kr">Kontak</span>
        <span class="t-es">Contacto</span>
      </div>
      <div class="id-rows">
        <div class="id-row">
          <span class="id-label">
            <span class="t-en">Phone</span>
            <span class="t-fr">Téléphone</span>
            <span class="t-kr">Telefòn</span>
            <span class="t-es">Teléfono</span>
          </span>
          <a class="id-value id-link" href={"tel:" + ngo.contact.phone}>📞 {ngo.contact.phone}</a>
        </div>
        <div class="id-row">
          <span class="id-label">Email</span>
          <a class="id-value id-link" href={"mailto:" + ngo.contact.email}>✉️ {ngo.contact.email}</a>
        </div>
        <div class="id-row">
          <span class="id-label">
            <span class="t-en">Website</span>
            <span class="t-fr">Site web</span>
            <span class="t-kr">Sit wèb</span>
            <span class="t-es">Sitio web</span>
          </span>
          <a class="id-value id-link" href={ngo.website} target="_blank" rel="noopener noreferrer">🌐 lassomer.fr</a>
        </div>
        <div class="id-row">
          <span class="id-label">
            <span class="t-en">Social</span>
            <span class="t-fr">Réseaux</span>
            <span class="t-kr">Rezo sosyal</span>
            <span class="t-es">Redes</span>
          </span>
          <div class="id-social">
            <a class="id-social-link" href={ngo.contact.facebook} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
            <a class="id-social-link" href={ngo.contact.instagram} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              Instagram
            </a>
            <a class="id-social-link" href={ngo.contact.youtube} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
              YouTube
            </a>
            <a class="id-social-link" href={ngo.contact.whatsapp} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  <hr class="divider" />

  <!-- The Fight -->
  <div class="fight-header">
    <span class="fight-title">
      <span class="t-en">⚔️ The Fight — Season <span id="fight-season-num">1</span></span>
      <span class="t-fr">⚔️ Le Fight — Saison <span id="fight-season-num-fr">1</span></span>
      <span class="t-kr">⚔️ Konba a — Sezon <span id="fight-season-num-kr">1</span></span>
      <span class="t-es">⚔️ La Pelea — Temporada <span id="fight-season-num-es">1</span></span>
    </span>
  </div>
  <div class="fight-sub">
    <span class="t-en">Companies vs. Community: who will support L'Asso-Mer the most before the season ends?</span>
    <span class="t-fr">Entreprises contre Communauté : qui soutiendra le plus L'Asso-Mer avant la fin de la saison ?</span>
    <span class="t-kr">Konpayi kont Kominote : ki moun ki pral sipòte L'Asso-Mer plis avan sezon an fini?</span>
    <span class="t-es">Empresas contra Comunidad: ¿quién apoyará más a L'Asso-Mer antes de que termine la temporada?</span>
  </div>

  <div class="fight-countdown-wrap">
    <span class="fight-countdown-label">
      <span class="t-en">Season ends in</span>
      <span class="t-fr">Fin de saison dans</span>
      <span class="t-kr">Sezon fini nan</span>
      <span class="t-es">La temporada termina en</span>
    </span>
    <span class="fight-countdown-time" id="fight-countdown">—</span>
  </div>

  <div class="fight-grid">
    <div class="fight-card" id="fight-community-card">
      <div class="fight-side-label">
        <span class="t-en">Community</span>
        <span class="t-fr">Communauté</span>
        <span class="t-kr">Kominote</span>
        <span class="t-es">Comunidad</span>
      </div>
      <div class="fight-amount"><span id="fight-community-amount">€0</span> <span class="fight-goal">/ <span id="fight-community-goal">€5,000</span></span></div>
      <div class="fight-gauge-track"><div class="fight-gauge-fill" id="fight-community-fill"></div></div>
      <div class="fight-meta"><span id="fight-community-contributors">0</span>
        <span class="t-en"> contributors</span>
        <span class="t-fr"> contributeurs</span>
        <span class="t-kr"> kontribistè</span>
        <span class="t-es"> contribuyentes</span>
      </div>
    </div>

    <div class="fight-card" id="fight-company-card">
      <div class="fight-side-label">
        <span class="t-en">Companies</span>
        <span class="t-fr">Entreprises</span>
        <span class="t-kr">Konpayi</span>
        <span class="t-es">Empresas</span>
      </div>
      <div class="fight-amount"><span id="fight-company-amount">€0</span> <span class="fight-goal">/ <span id="fight-company-goal">€5,000</span></span></div>
      <div class="fight-gauge-track"><div class="fight-gauge-fill" id="fight-company-fill"></div></div>
      <div class="fight-meta"><span id="fight-company-contributors">0</span>
        <span class="t-en"> companies</span>
        <span class="t-fr"> entreprises</span>
        <span class="t-kr"> konpayi</span>
        <span class="t-es"> empresas</span>
      </div>
    </div>
  </div>

  <div class="fight-report-cta">
    <p>
      <span class="t-en">Did you give to L'Asso-Mer? Report your contribution to push your side forward.</span>
      <span class="t-fr">Vous avez donné à L'Asso-Mer ? Signalez votre contribution pour faire avancer votre camp.</span>
      <span class="t-kr">Ou te bay L'Asso-Mer? Rapòte kontribisyon ou pou fè kan ou avanse.</span>
      <span class="t-es">¿Le diste a L'Asso-Mer? Reporta tu contribución para hacer avanzar a tu equipo.</span>
    </p>
    <button class="btn-report" id="btn-report-contribution" type="button">
      <span class="t-en">Report a contribution</span>
      <span class="t-fr">Signaler une contribution</span>
      <span class="t-kr">Rapòte yon kontribisyon</span>
      <span class="t-es">Reportar una contribución</span>
    </button>
  </div>

  <form id="fight-form">
    <div class="fight-side-choice">
      <label><input type="radio" name="side" value="community" checked />
        <span class="t-en">Community</span><span class="t-fr">Communauté</span><span class="t-kr">Kominote</span><span class="t-es">Comunidad</span>
      </label>
      <label><input type="radio" name="side" value="company" />
        <span class="t-en">Company</span><span class="t-fr">Entreprise</span><span class="t-kr">Konpayi</span><span class="t-es">Empresa</span>
      </label>
    </div>
    <div>
      <label for="fight-amount">
        <span class="t-en">Amount given (€)</span><span class="t-fr">Montant donné (€)</span><span class="t-kr">Kantite bay (€)</span><span class="t-es">Monto dado (€)</span>
      </label>
      <input type="number" id="fight-amount" min="1" step="1" required />
    </div>
    <div>
      <label for="fight-name">
        <span class="t-en">Name (optional — company or, if you want to be listed, your name)</span>
        <span class="t-fr">Nom (optionnel — nom d'entreprise, ou le vôtre si vous voulez être listé)</span>
        <span class="t-kr">Non (opsyonèl)</span>
        <span class="t-es">Nombre (opcional)</span>
      </label>
      <input type="text" id="fight-name" maxlength="120" />
    </div>
    <div>
      <label for="fight-siret">
        <span class="t-en">SIRET (companies only)</span><span class="t-fr">SIRET (entreprises uniquement)</span><span class="t-kr">SIRET (konpayi sèlman)</span><span class="t-es">SIRET (solo empresas)</span>
      </label>
      <input type="text" id="fight-siret" maxlength="14" pattern="[0-9]{14}" />
    </div>
    <div>
      <label for="fight-note">
        <span class="t-en">Note (optional, for our review only — never shown publicly)</span>
        <span class="t-fr">Note (optionnelle, pour notre vérification uniquement — jamais publique)</span>
        <span class="t-kr">Nòt (opsyonèl)</span>
        <span class="t-es">Nota (opcional)</span>
      </label>
      <textarea id="fight-note" maxlength="500" rows="2"></textarea>
    </div>
    <button type="submit">
      <span class="t-en">Submit</span><span class="t-fr">Envoyer</span><span class="t-kr">Voye</span><span class="t-es">Enviar</span>
    </button>
    <div class="fight-form-msg" id="fight-form-msg"></div>
  </form>

  <details class="quiz-accordion">
    <summary>
      <span class="t-en">🧠 Learn about the cause</span>
      <span class="t-fr">🧠 En savoir plus sur la cause</span>
      <span class="t-kr">🧠 Aprann sou koz la</span>
      <span class="t-es">🧠 Aprende sobre la causa</span>
    </summary>
    <div style="padding: 0 16px 16px;">
      <div class="quiz-cta">
        <button class="btn-quiz" id="btn-start-quiz">
          <span class="t-en">🧠 Take the quiz</span>
          <span class="t-fr">🧠 Faire le quiz</span>
          <span class="t-kr">🧠 Fè kwiz la</span>
          <span class="t-es">🧠 Hacer el quiz</span>
        </button>
      </div>
      <p style="font-size:12px; color:#7a9a9a; margin-top:10px;">
        <span class="t-en">Marine ecology quiz — no financial contribution needed. Every time the quiz gauge fills before the fight ends, the season is extended 7 days (up to twice) — more time for both sides.</span>
        <span class="t-fr">Quiz sur l'écologie marine — aucune contribution financière requise. Chaque fois que la jauge du quiz se remplit avant la fin du fight, la saison est prolongée de 7 jours (2 fois maximum) — plus de temps pour les deux camps.</span>
        <span class="t-kr">Quiz sou ekoloji maren — pa gen kontribisyon finansye ki nesesè. Chak fwa jwaj kwiz la ranpli avan konba a fini, sezon an pwolonje 7 jou (2 fwa maksimòm).</span>
        <span class="t-es">Quiz de ecología marina — no se necesita contribución financiera. Cada vez que el medidor del quiz se llena antes de que termine la pelea, la temporada se extiende 7 días (hasta dos veces).</span>
      </p>

      <!-- Quiz question flow — DOM structure, IDs and classes unchanged from the
           original page; only this comment and its new position (inside the
           collapsed accordion) are new. public/scripts/ngo.js's existing quiz logic
           (startQuiz, renderQuizQuestion, selectAnswer, etc.) targets these same IDs
           and needs no changes to keep working here. -->
      <div id="quiz-section">
        <div class="quiz-box">
          <div class="quiz-progress">
            <div class="quiz-step" id="quiz-step-label">
              <span class="t-en">Question 1 of 8</span>
              <span class="t-fr">Question 1 sur 8</span>
              <span class="t-kr">Kèstyon 1 sou 8</span>
              <span class="t-es">Pregunta 1 de 8</span>
            </div>
            <div class="quiz-dots" id="quiz-dots"></div>
          </div>
          <div class="quiz-question" id="quiz-question"></div>
          <div class="quiz-options" id="quiz-options"></div>
          <div class="quiz-feedback" id="quiz-feedback"></div>
          <button class="quiz-next" id="quiz-next">
            <span class="t-en">Next →</span>
            <span class="t-fr">Suivant →</span>
            <span class="t-kr">Swivan →</span>
            <span class="t-es">Siguiente →</span>
          </button>
        </div>
      </div>

      <!-- Quiz result — unchanged -->
      <div id="quiz-result">
        <div class="result-box">
          <div class="result-score" id="result-score">0/5</div>
          <div class="result-label" id="result-label"></div>
          <div class="result-contribution" id="result-contribution"></div>
          <div class="result-round-label" id="result-round-label"></div>
          <div class="result-actions">
            <button class="btn-replay" id="btn-replay">
              <span class="t-en">Play again</span>
              <span class="t-fr">Rejouer</span>
              <span class="t-kr">Jwe ankò</span>
              <span class="t-es">Jugar de nuevo</span>
            </button>
            <a class="btn-donate" href="https://www.lassomer.fr/" target="_blank" rel="noopener noreferrer">
              <span class="t-en">Donate to go further →</span>
              <span class="t-fr">Faire un don pour aller plus loin →</span>
              <span class="t-kr">Fè on don pou avanse plis →</span>
              <span class="t-es">Donar para ir más lejos →</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Mission accomplished — copy REWRITTEN below, everything else unchanged.
           Old copy claimed "L'Asso-Mer's visibility has been renewed," which is no
           longer true now that the quiz's payoff is a fight extension, not a
           visibility renewal. New copy is deliberately outcome-agnostic (doesn't say
           "extended by 7 days" specifically) because which of the two outcomes
           actually happened — extension vs. forced season close — is decided
           server-side in workers/ngo-fight and this static markup can't know which
           one fired; it points the user at the countdown/gauges above instead of
           asserting a specific result. -->
      <div id="mission-accomplished">
        <div class="mission-box">
          <div class="mission-icon">🎉</div>
          <div class="mission-title">
            <span class="t-en">Mission accomplished!</span>
            <span class="t-fr">Mission accomplie !</span>
            <span class="t-kr">Misyon akonpli !</span>
            <span class="t-es">¡Misión cumplida!</span>
          </div>
          <div class="mission-text">
            <span class="t-en">The quiz gauge reached 100%! This pushes the fight forward — check the countdown above, it may have just changed.</span>
            <span class="t-fr">La jauge du quiz a atteint 100 % ! Cela fait avancer le fight — regardez le compte à rebours ci-dessus, il vient peut-être de changer.</span>
            <span class="t-kr">Jwaj kwiz la rive 100% ! Sa a ede konba a avanse — gade kont-a-rebò anwo a, li ka fenk chanje.</span>
            <span class="t-es">¡El medidor del quiz alcanzó el 100%! Esto impulsa la pelea — mira la cuenta regresiva arriba, puede que acabe de cambiar.</span>
          </div>
        </div>
      </div>
    </div>
  </details>

  <hr class="divider" />

  <div class="fight-history-title">
    <span class="t-en">Previous seasons</span>
    <span class="t-fr">Saisons précédentes</span>
    <span class="t-kr">Sezon anvan yo</span>
    <span class="t-es">Temporadas anteriores</span>
  </div>
  <div id="fight-history-list"></div>

  <hr class="divider" />

  <!-- Sponsor CTA -->
  <div class="ngo-cta">
    <a href="/sponsor/" class="ngo-cta-link">
      <span class="t-en">Become a sponsor and give more time to the mission →</span>
      <span class="t-fr">Devenir sponsor et offrir plus de temps à la mission →</span>
      <span class="t-kr">Vin sponsor epi ban misyon la plis tan →</span>
      <span class="t-es">Conviértete en sponsor y da más tiempo a la misión →</span>
    </a>
  </div>

</main>

<div id="ngo-config" hidden
  data-period-start={ngo.sponsorship.start}
  data-period-end={ngo.sponsorship.end}></div>
<div id="quiz-data" hidden data-questions={JSON.stringify(quizQuestions)}></div>
<script is:inline src="/scripts/ngo.js" defer></script>
<PageFooter />
</body>
</html>
