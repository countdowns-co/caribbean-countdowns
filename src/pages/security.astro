---
import LiveBanner from "../components/LiveBanner.astro";
import PageFooter from "../components/PageFooter.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Security — caribbean.countdowns.co</title>
  <style>.t-fr,.t-kr,.t-es{display:none}.lang-row{display:flex;align-items:center;gap:16px}</style>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0a0f0f;
      color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
    }

    .page { max-width: 860px; margin: 0 auto; padding: 40px 24px 80px; }

    a { color: inherit; text-decoration: none; }
    a:hover { text-decoration: underline; }

    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .site-title {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.3px;
      color: #fff;
    }

    .back-link {
      font-size: 12px;
      color: #999999;
      text-decoration: none;
      letter-spacing: 0.3px;
    }
    .back-link:hover { color: #888; }

    .lang-group {
      display: flex;
      gap: 4px;
      flex-shrink: 0;
    }

    .lang-btn {
      background: transparent;
      border: 1px solid #555;
      border-radius: 3px;
      cursor: pointer;
      font-size: 18px;
      letter-spacing: 0;
      padding: 2px 6px;
      color: #aaa;
      font-family: inherit;
      transition: all 0.15s;
      opacity: 0.75;
    }
    .lang-btn:hover { border-color: #888; opacity: 0.8; }
    .lang-btn.active { background: #1a1a1a; border-color: #555; opacity: 1; }

    .page-title { font-size: 20px; font-weight: 700; margin-bottom: 4px; }
    .subtitle { font-size: 13px; color: #999999; margin-bottom: 40px; }

    .scores-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-bottom: 48px;
    }

    .score-card {
      background: #0d1a1a;
      border: 1px solid #1a3030;
      border-radius: 8px;
      padding: 24px;
      color: inherit;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .service-name {
      font-size: 13px;
      font-weight: 700;
      color: #aaa;
      letter-spacing: 0.3px;
    }

    .grade-badge {
      font-size: 22px;
      font-weight: 800;
      padding: 4px 12px;
      border-radius: 6px;
      line-height: 1.4;
      flex-shrink: 0;
    }
    .grade-Aplus  { color: #4ade80; background: #0d2a0d; border: 1px solid #166534; }
    .grade-A      { color: #a3e635; background: #1a2a08; border: 1px solid #365314; }
    .grade-clean  { color: #5eead4; background: #0d2a2a; border: 1px solid #0d9488; }
    .grade-safe    { color: #5eead4; background: #0d2a2a; border: 1px solid #0d9488; font-size: 13px; }
    .grade-pending { color: #a78bfa; background: #1a0d2a; border: 1px solid #6d28d9; font-size: 12px; }
    .grade-score   { color: #fbbf24; background: #1a1000; border: 1px solid #d97706; font-size: 12px; }
    .grade-silver  { color: #cbd5e1; background: #1a1e26; border: 1px solid #64748b; font-size: 13px; }
    .grade-gold    { color: #fcd34d; background: #1a1200; border: 1px solid #b45309; font-size: 13px; }

    .card-desc {
      font-size: 12px;
      color: #999999;
      line-height: 1.5;
    }

    .card-link {
      font-size: 11px;
      color: #0d9488;
      letter-spacing: 0.3px;
    }

    .section-title {
      font-size: 13px;
      font-weight: 700;
      color: #888;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .contact-box {
      background: #0d1a1a;
      border: 1px solid #1a3030;
      border-radius: 8px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .contact-box p { font-size: 13px; color: #aaa; }
    .contact-btn {
      display: inline-block;
      background: #0d2a2a;
      border: 1px solid #0d9488;
      border-radius: 5px;
      color: #5eead4;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 20px;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s;
      flex-shrink: 0;
    }
    .contact-btn:hover { background: #0d3535; }

    .pipeline-card {
      background: #0d1a1a;
      border: 1px solid #1a3030;
      border-radius: 8px;
      padding: 24px;
      margin-bottom: 48px;
    }

    .pipeline-checks {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }

    .check-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .check-icon {
      color: #4ade80;
      font-size: 14px;
      font-weight: 800;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .check-label strong {
      color: #e0e0e0;
      font-size: 12px;
      font-weight: 700;
      display: block;
      margin-bottom: 3px;
    }

    .check-label .check-desc {
      font-size: 11px;
      color: #999999;
      line-height: 1.5;
    }

    .badge-img {
      height: 22px;
      border-radius: 3px;
      display: block;
    }

    .pipeline-footer {
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid #1a3030;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .pipeline-footer-label {
      font-size: 11px;
      color: #999999;
    }

  </style>
</head>
<body>
<LiveBanner />
<div class="page">

  <div class="header-row">
    <h1 class="site-title"><a href="/">Countdowns</a></h1>
    <div class="lang-row">
      <a class="back-link" href="/">
        <span class="t-en">← Back</span>
        <span class="t-fr">← Retour</span>
        <span class="t-kr">← Retounen</span>
        <span class="t-es">← Volver</span>
      </a>
      <div class="lang-group">
        <button class="lang-btn" data-lang="en" title="English">🇬🇧</button>
        <button class="lang-btn" data-lang="kr" title="Kréyol">🇭🇹</button>
        <button class="lang-btn" data-lang="fr" title="Français">🇫🇷</button>
        <button class="lang-btn" data-lang="es" title="Español">🇪🇸</button>
      </div>
    </div>
  </div>

  <p class="page-title">🔒 <span class="t-en">Security</span><span class="t-fr">Sécurité</span><span class="t-kr">Sekirite</span><span class="t-es">Seguridad</span></p>
  <p class="subtitle">
    <span class="t-en">Third-party security assessments for caribbean.countdowns.co</span>
    <span class="t-fr">Évaluations de sécurité tierces pour caribbean.countdowns.co</span>
    <span class="t-kr">Evalyasyon sekirite pou caribbean.countdowns.co</span>
    <span class="t-es">Evaluaciones de seguridad de terceros para caribbean.countdowns.co</span>
  </p>

  <div class="scores-grid">

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">HTTP Headers<br>Security Grade</span>
        <span class="grade-badge grade-Aplus">A+</span>
      </div>
      <p class="card-desc">
        <span class="t-en">Tests HTTP headers, CSP, cookies, and HTTPS configuration against Mozilla's security guidelines.</span>
        <span class="t-fr">Teste les en-têtes HTTP, CSP, cookies et la configuration HTTPS selon les recommandations de sécurité de Mozilla.</span>
        <span class="t-kr">Teste en-tèt HTTP, CSP, cookie ak konfigirasyon HTTPS selon règleman sekirite Mozilla.</span>
        <span class="t-es">Prueba los encabezados HTTP, CSP, cookies y la configuración HTTPS según las pautas de seguridad de Mozilla.</span>
      </p>
      <a class="card-link" href="https://developer.mozilla.org/en-US/observatory/analyze?host=caribbean.countdowns.co" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">SSL/TLS Server<br>Security Grade</span>
        <span class="grade-badge grade-A">A+</span>
      </div>
      <p class="card-desc">
        <span class="t-en">Qualys SSL Labs deep analysis of TLS configuration, certificate chain, and cipher suites.</span>
        <span class="t-fr">Analyse approfondie de la configuration TLS, de la chaîne de certificats et des suites de chiffrement par Qualys SSL Labs.</span>
        <span class="t-kr">Analiz TLS, chèn sètifika ak suite chiffrement Qualys SSL Labs.</span>
        <span class="t-es">Análisis profundo de la configuración TLS, la cadena de certificados y los conjuntos de cifrado de Qualys SSL Labs.</span>
      </p>
      <a class="card-link" href="https://www.ssllabs.com/ssltest/analyze.html?d=caribbean.countdowns.co" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Security Headers<br>Grade</span>
        <span class="grade-badge grade-Aplus">A+</span>
      </div>
      <p class="card-desc">
        <span class="t-en">Scans and grades HTTP response headers for completeness and security best practices.</span>
        <span class="t-fr">Analyse et note les en-têtes de réponse HTTP pour leur complétude et les bonnes pratiques de sécurité.</span>
        <span class="t-kr">Verifye epi note en-tèt repons HTTP pou konplètès ak bon pratik sekirite.</span>
        <span class="t-es">Analiza y califica los encabezados de respuesta HTTP según su completitud y las mejores prácticas de seguridad.</span>
      </p>
      <a class="card-link" href="https://securityheaders.com/?q=https%3A%2F%2Fcaribbean.countdowns.co" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Blacklight<br>Privacy Checker</span>
        <span class="grade-badge grade-safe">Safe</span>
      </div>
      <p class="card-desc">
        <span class="t-en">0 ad trackers · 0 third-party cookies · no fingerprinting · no session recording · no keylogging · no social pixels.</span>
        <span class="t-fr">0 traceur · 0 cookie tiers · pas de fingerprinting · pas d'enregistrement de session · pas de keylogging · pas de pixels sociaux.</span>
        <span class="t-kr">0 tracè · 0 cookie tès · pa gen fingerprinting · pa gen anrejistreman sesyon · pa gen keylogging · pa gen piksèl sosyal.</span>
        <span class="t-es">0 rastreadores · 0 cookies de terceros · sin fingerprinting · sin grabación de sesión · sin keylogging · sin píxeles sociales.</span>
      </p>
      <a class="card-link" href="https://themarkup.org/blacklight?url=caribbean.countdowns.co" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Google<br>Safe Browsing</span>
        <span class="grade-badge grade-safe">Safe</span>
      </div>
      <p class="card-desc">
        <span class="t-en">No unsafe content found — no malware, phishing, or unwanted software detected on this site.</span>
        <span class="t-fr">Aucun contenu dangereux détecté — pas de malware, phishing ou logiciel indésirable sur ce site.</span>
        <span class="t-kr">Pa gen kontni danjere jwenn — pa gen malware, phishing oswa lojisyèl enpòtan detekte sou sit sa.</span>
        <span class="t-es">No se encontró contenido peligroso — sin malware, phishing ni software no deseado en este sitio.</span>
      </p>
      <a class="card-link" href="https://transparencyreport.google.com/safe-browsing/search?url=caribbean.countdowns.co" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">GDPR<br>Compliance Checker</span>
        <span class="grade-badge grade-safe">Safe</span>
      </div>
      <p class="card-desc">
        <span class="t-en">GDPR compliance scan found no consent violations, cookie issues, or data protection concerns.</span>
        <span class="t-fr">L'analyse de conformité RGPD n'a révélé aucune violation du consentement, problème de cookie ou manquement à la protection des données.</span>
        <span class="t-kr">Analiz konfòmite RGPD pa jwenn okenn vyolasyon konsantman, pwoblèm cookie oswa enkyetid pwoteksyon done.</span>
        <span class="t-es">El análisis de cumplimiento del RGPD no encontró violaciones de consentimiento, problemas de cookies ni fallos en la protección de datos.</span>
      </p>
      <a class="card-link" href="https://2gdpr.com/" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">OpenSSF Scorecard</span>
        <span class="grade-badge grade-silver">8.9 / 10</span>
      </div>
      <p class="card-desc">
        <span class="t-en">Automated supply-chain security analysis — checks SHA-pinned dependencies, branch protection, token permissions, and CI hygiene. Score updates automatically on each push to main.</span>
        <span class="t-fr">Analyse automatique de la chaîne d'approvisionnement — vérifie les dépendances épinglées, la protection des branches, les permissions et l'hygiène CI. Score mis à jour automatiquement à chaque push sur main.</span>
        <span class="t-kr">Analiz otomatik sekirite chèn aprovizyon — verifye depandans SHA-epingle, pwoteksyon branch, pèmisyon token ak ijyèn CI. Nòt mete ajou otomatikman chak push sou main.</span>
        <span class="t-es">Análisis automatizado de cadena de suministro — verifica dependencias SHA-ancladas, protección de ramas, permisos de token e higiene CI. La puntuación se actualiza automáticamente en cada push a main.</span>
      </p>
      <a class="card-link" href="https://scorecard.dev/viewer/?uri=github.com/countdowns-co/caribbean-countdowns" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">OpenSSF<br>Best Practices</span>
        <span class="grade-badge grade-silver">Silver</span>
      </div>
      <p class="card-desc">
        <span class="t-en">CII Best Practices badge — certifies the project follows open-source security and quality standards: vulnerability reporting, CI testing, signed releases, and contributor guidelines.</span>
        <span class="t-fr">Badge CII Best Practices — certifie que le projet respecte les standards de sécurité et de qualité open source : signalement des vulnérabilités, tests CI, releases signées et guide contributeur.</span>
        <span class="t-kr">Badj CII Best Practices — sètifye pwojè a swiv estanda sekirite ak kalite sous louvri : rapò vilnerabilite, tès CI, vèsyon siyen ak gid kontribitè.</span>
        <span class="t-es">Insignia CII Best Practices — certifica que el proyecto sigue los estándares de seguridad y calidad de código abierto: reporte de vulnerabilidades, pruebas CI, versiones firmadas y guía de contribución.</span>
      </p>
      <a class="card-link" href="https://www.bestpractices.dev/en/projects/12911/silver" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View certification ↗</span>
        <span class="t-fr">Voir la certification ↗</span>
        <span class="t-kr">Wè sètifikasyon ↗</span>
        <span class="t-es">Ver certificación ↗</span>
      </a>
    </div>

    <div class="score-card">
      <div class="card-header">
        <span class="service-name">Snyk</span>
        <span class="grade-badge grade-gold">
          <span class="t-en">0 vulnerability</span>
          <span class="t-fr">0 vulnérabilité</span>
          <span class="t-kr">0 vilnerabilite</span>
          <span class="t-es">0 vulnerabilidad</span>
        </span>
      </div>
      <p class="card-desc">
        <span class="t-en">Dependency vulnerability scan — no known security issues found in npm packages.</span>
        <span class="t-fr">Analyse des dépendances — aucune vulnérabilité connue détectée dans les paquets npm.</span>
        <span class="t-kr">Analiz depandans — pa gen vulnerabilite konnu jwenn nan pake npm yo.</span>
        <span class="t-es">Análisis de dependencias — no se encontraron vulnerabilidades conocidas en los paquetes npm.</span>
      </p>
      <a class="card-link" href="https://snyk.io/test/github/countdowns-co/caribbean-countdowns" target="_blank" rel="noopener noreferrer">
        <span class="t-en">View full report ↗</span>
        <span class="t-fr">Voir le rapport complet ↗</span>
        <span class="t-kr">Wè rapò konplè ↗</span>
        <span class="t-es">Ver informe completo ↗</span>
      </a>
    </div>

  </div>

  <p class="section-title">
    <span class="t-en">Build Integrity</span>
    <span class="t-fr">Intégrité du build</span>
    <span class="t-kr">Entegrite bild la</span>
    <span class="t-es">Integridad del build</span>
  </p>
  <div class="pipeline-card">
    <div class="pipeline-checks">

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>SHA-pinned Actions</strong>
          <span class="check-desc">
            <span class="t-en">All CI actions pinned to exact commit SHA — prevents malicious tag overwrites.</span>
            <span class="t-fr">Actions CI épinglées à un SHA exact — empêche la substitution malveillante de tag.</span>
            <span class="t-kr">Aksyon CI epingle nan SHA egzak — anpeche ranplasman tag malveyan.</span>
            <span class="t-es">Acciones CI ancladas a un SHA exacto — previene sobrescrituras de etiquetas maliciosas.</span>
          </span>
        </span>
      </div>

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>npm ci — deterministic installs</strong>
          <span class="check-desc">
            <span class="t-en">Lock-file-strict — no silent dependency drift between builds.</span>
            <span class="t-fr">Strict selon le lock-file — pas de dérive silencieuse des dépendances.</span>
            <span class="t-kr">Strict sou fichye lock — pa gen chanjman silen depandans.</span>
            <span class="t-es">Estricto según lock-file — sin drift silencioso de dependencias.</span>
          </span>
        </span>
      </div>

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>JSON validated pre-build</strong>
          <span class="check-desc">
            <span class="t-en">Event data checked with python3 — malformed JSON breaks the pipeline, not the site.</span>
            <span class="t-fr">Données vérifiées avec python3 — un JSON invalide bloque le pipeline, pas le site.</span>
            <span class="t-kr">Done evènman verifye ak python3 — JSON enfòm kase pipeline a, pa sit la.</span>
            <span class="t-es">Datos verificados con python3 — JSON malformado rompe el pipeline, no el sitio.</span>
          </span>
        </span>
      </div>

      <div class="check-item">
        <span class="check-icon">✓</span>
        <span class="check-label">
          <strong>npm audit — CVE gate</strong>
          <span class="check-desc">
            <span class="t-en">High-severity CVEs block every deploy — no known vulnerabilities reach production.</span>
            <span class="t-fr">Les CVE de haute sévérité bloquent chaque deploy — aucune vulnérabilité connue en production.</span>
            <span class="t-kr">CVE wo nivo bloke chak deploy — pa gen vilnerabilite konnu nan pwodiksyon.</span>
            <span class="t-es">Las CVE de alta gravedad bloquean cada deploy — ninguna vulnerabilidad conocida llega a producción.</span>
          </span>
        </span>
      </div>

    </div>
    <div class="pipeline-footer">
      <span class="pipeline-footer-label">
        <span class="t-en">Live deploy status:</span>
        <span class="t-fr">Statut du deploy :</span>
        <span class="t-kr">Estati deploy:</span>
        <span class="t-es">Estado del deploy:</span>
      </span>
      <a href="https://github.com/countdowns-co/caribbean-countdowns/actions/workflows/deploy.yml" target="_blank" rel="noopener noreferrer">
        <img class="badge-img" src="https://github.com/countdowns-co/caribbean-countdowns/actions/workflows/deploy.yml/badge.svg" alt="Deploy status" />
      </a>
    </div>
  </div>

  <p class="section-title">
    <span class="t-en">Report a vulnerability</span>
    <span class="t-fr">Signaler une vulnérabilité</span>
    <span class="t-kr">Rapòte yon vilnerabilite</span>
    <span class="t-es">Reportar una vulnerabilidad</span>
  </p>
