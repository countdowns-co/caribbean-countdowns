---
import LiveBanner from "../components/LiveBanner.astro";
import PageFooter from "../components/PageFooter.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suggest an Event — countdowns.co</title>
  <meta name="description" content="Suggest a Caribbean festival, carnival or regatta — a simple step-by-step wizard to submit event details for listing on countdowns.co." />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0f0f0f; color: #e0e0e0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 14px; line-height: 1.6;
      min-height: 100vh; padding: 48px 24px 80px;
    }
    .page { max-width: 540px; margin: 0 auto; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; }
    .back-link { font-size: 12px; color: #999999; text-decoration: underline; }
    .back-link:hover { color: #999; }
    .lang-group { display: flex; gap: 4px; flex-shrink: 0; }
    .lang-btn { background: transparent; border: 1px solid #555; border-radius: 3px; cursor: pointer; font-size: 16px; padding: 2px 6px; color: #aaa; font-family: inherit; transition: all 0.15s; opacity: 0.75; }
    .lang-btn:hover { border-color: #888; opacity: 0.8; }
    .lang-btn.active { background: #1a1a1a; border-color: #555; opacity: 1; }
    details.criteria-box { background: #0a0f1a; border: 1px solid #1e3a5f; border-radius: 4px; padding: 10px 16px; margin-bottom: 32px; }
    .criteria-toggle { cursor: pointer; list-style: none; font-size: 13px; color: #7ec8e3; }
    .criteria-toggle:hover { color: #b3e4f7; }
    .criteria-toggle::marker { display: none; }
    .criteria-list { margin-top: 10px; padding-top: 10px; border-top: 1px solid #1e3a5f; display: flex; flex-direction: column; gap: 6px; }
    .criteria-list span { color: #5a8fad; font-size: 12px; }
    .criteria-list strong { color: #7ec8e3; }
    #wizardProgress { display: flex; gap: 3px; margin-bottom: 36px; }
    .progress-seg { height: 3px; flex: 1; background: #333; border-radius: 2px; transition: background 0.2s; }
    .progress-seg.filled { background: #2d6aa0; }
    #wizardStep { min-height: 200px; }
    .step-num { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #999999; margin-bottom: 10px; }
    .step-question { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 6px; }
    .step-hint { font-size: 12px; color: #999999; margin-bottom: 20px; }
    .step-input { width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 4px; color: #e0e0e0; font-family: inherit; font-size: 14px; padding: 10px 12px; outline: none; transition: border-color 0.15s; }
    .step-input:focus { border-color: #2d6aa0; }
    .step-textarea { resize: vertical; min-height: 80px; }
    .date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .date-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.6px; color: #999999; margin-bottom: 6px; }
    .tz-note { font-size: 11px; color: #2d6aa0; margin-top: 6px; }
    .details-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
    .detail-option { cursor: pointer; padding: 4px 12px; border-radius: 3px; border: 1px solid #333; background: transparent; color: #999; font-size: 12px; font-family: inherit; transition: all 0.15s; user-select: none; }
    .detail-option.selected { background: #1e3a5f; border-color: #2d6aa0; color: #7ec8e3; }
    .ticket-row { display: grid; grid-template-columns: 150px 1fr; gap: 8px; align-items: center; margin-bottom: 8px; }
    .platform-url { display: none; }
    .platform-url.visible { display: block; }
    .done-title { font-size: 16px; font-weight: 700; color: #4ade80; margin-bottom: 6px; }
    .done-hint { font-size: 12px; color: #999999; margin-bottom: 20px; }
    .btn-submit { width: 100%; background: #0d2a1a; border: 1px solid #166534; color: #4ade80; border-radius: 4px; padding: 12px; cursor: pointer; font-size: 13px; font-family: inherit; font-weight: 600; transition: background 0.15s; margin-bottom: 16px; }
    .btn-submit:hover:not(:disabled) { background: #113520; }
    .btn-submit:disabled { opacity: 0.5; cursor: wait; }
    .submit-error { font-size: 12px; color: #f87171; margin-bottom: 12px; }
    #wizardNav { display: flex; gap: 10px; margin-top: 28px; }
    .is-hidden { display: none; }
    #btnBack { background: transparent; border: 1px solid #333; border-radius: 4px; color: #999999; font-size: 13px; font-family: inherit; padding: 10px 22px; cursor: pointer; transition: all 0.15s; }
    #btnBack:hover { border-color: #555; color: #aaa; }
    #btnNext { background: #1e3a5f; border: 1px solid #2d6aa0; border-radius: 4px; color: #7ec8e3; font-size: 13px; font-family: inherit; font-weight: 600; padding: 10px 28px; cursor: pointer; transition: background 0.15s; }
    #btnNext:hover:not(:disabled) { background: #24497a; }
    #btnNext:disabled { opacity: 0.35; cursor: not-allowed; }
  </style>
</head>
<body>
<LiveBanner />
<div class="page">
  <div class="page-header">
    <a class="back-link" href="/">
      <span class="t-en">← Back</span>
      <span class="t-fr">← Retour</span>
      <span class="t-kr">← Retounen</span>
      <span class="t-es">← Volver</span>
    </a>
    <div class="lang-group">
      <button class="lang-btn" data-lang="en" title="English">🇬🇧</button>
      <button class="lang-btn" data-lang="kr" title="Kréyol">🇭🇹</button>
      <button class="lang-btn" data-lang="fr" title="Français">🇫🇷</button>
      <button class="lang-btn" data-lang="es" title="Español">🇪🇸</button>
    </div>
  </div>
  <details class="criteria-box">
    <summary class="criteria-toggle">
      <span class="t-en">▸ Listing criteria</span>
      <span class="t-fr">▸ Critères de sélection</span>
      <span class="t-kr">▸ Kritè seleksyon</span>
      <span class="t-es">▸ Criterios de selección</span>
    </summary>
    <div class="criteria-list">
      <span>
        <span class="t-en">Listed if it meets <strong>all 3 criteria:</strong></span>
        <span class="t-fr">Listé s'il remplit <strong>les 3 critères :</strong></span>
        <span class="t-kr">Liste si li ranpli <strong>tout 3 kritè yo :</strong></span>
        <span class="t-es">Listado si cumple <strong>los 3 criterios:</strong></span>
      </span>
      <span>
        <span class="t-en">① <strong>Recurring</strong> — minimum 2nd edition</span>
        <span class="t-fr">① <strong>Récurrence</strong> — minimum 2ème édition</span>
        <span class="t-kr">① <strong>Rekidiv</strong> — minimòm 2yèm edisyon</span>
        <span class="t-es">① <strong>Recurrencia</strong> — mínimo 2ª edición</span>
      </span>
      <span>
        <span class="t-en">② <strong>Public</strong> — 200+ participants or visitors</span>
        <span class="t-fr">② <strong>Public</strong> — 200+ participants ou visiteurs</span>
        <span class="t-kr">② <strong>Piblik</strong> — 200+ patisipan oswa vizitè</span>
        <span class="t-es">② <strong>Público</strong> — 200+ participantes o visitantes</span>
      </span>
      <span>
        <span class="t-en">③ <strong>Organized</strong> — by a registered entity OR documented in media/official listing</span>
        <span class="t-fr">③ <strong>Organisé</strong> — par une entité enregistrée OU documenté dans les médias/listes officielles</span>
        <span class="t-kr">③ <strong>Òganize</strong> — pa yon antite anrejistre OSI dokimante nan media/lis ofisyèl</span>
        <span class="t-es">③ <strong>Organizado</strong> — por una entidad registrada O documentado en medios/listados oficiales</span>
      </span>
    </div>
  </details>
  <div id="wizardProgress"></div>
  <div id="wizardStep"></div>
  <div id="wizardNav">
    <button id="btnBack" class="is-hidden"></button>
    <button id="btnNext"></button>
  </div>
</div>
<script is:inline src="/scripts/suggest-event.js" defer></script>
<PageFooter />
</body>
</html>
