<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>NGO Fight — Review</title>
  <style>
    * { box-sizing: border-box; }
    body { background:#0a0f0f; color:#e0e0e0; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; padding: 24px; max-width: 720px; margin: 0 auto; }
    h1 { font-size: 18px; color:#fff; margin-bottom: 16px; }
    .entry { background:#0a1a1a; border:1px solid #1a3a3a; border-radius:8px; padding:14px 16px; margin-bottom:10px; }
    .entry-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
    .side { font-size:10px; font-weight:700; text-transform:uppercase; padding:3px 8px; border-radius:4px; }
    .side.company { color:#5eead4; background:#0d2a2a; border:1px solid #0d9488; }
    .side.community { color:#34d399; background:#0d2a1a; border:1px solid #14532d; }
    .amount { font-size:17px; font-weight:700; color:#fff; }
    .meta { font-size:12px; color:#7a9a9a; margin-bottom:4px; }
    .meta strong { color:#e0e0e0; }
    .note { font-size:11.5px; color:#5a9a90; font-style:italic; margin-bottom:10px; }
    button { font-size:12px; font-weight:700; border:none; border-radius:5px; padding:7px 14px; cursor:pointer; margin-right:8px; }
    .approve { background:#34d399; color:#06201c; }
    .reject { background:transparent; border:1px solid #7a2e2e; color:#f0a0a0; }
    #empty { color:#7a9a9a; font-size:13px; }
  </style>
</head>
<body>
  <h1>🛡️ Modération — Le Fight</h1>
  <div id="list"></div>
  <p id="empty" style="display:none;">Aucune entrée en attente.</p>

  <script is:inline src="/scripts/ngo-fight-review.js" defer></script>
</body>
</html>
