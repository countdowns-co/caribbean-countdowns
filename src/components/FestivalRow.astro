---
import ecoCriteria from "../data/eco-criteria.json";
import { tzDayStart, tzDayEnd } from "../utils/tz";
import { computeEcoGrade } from "../utils/eco";
// `eager` cards (above the fold) paint their background inline; others defer it
// to a data-bg attribute loaded on scroll (see index.js IntersectionObserver).
const { festival, eager = false } = Astro.props;

const ecoGrade = computeEcoGrade(festival.eco, ecoCriteria as any[]);

const tz = festival.timezone ?? "America/Martinique";
const startMs = tzDayStart(festival.startDate, tz);
const endMs   = tzDayEnd(festival.endDate, tz);
const nowMs   = Date.now();

let status = "";
if (nowMs > endMs) {
  status = "ENDED";
} else if (nowMs >= startMs) {
  status = "LIVE";
} else {
  status = "UPCOMING";
}

const countdownTarget =
  status === "ENDED" ? endMs :
  status === "LIVE"  ? endMs :
  startMs;

// Use noon UTC so toLocaleDateString always shows the correct calendar date
// regardless of build-server timezone (startMs/endMs can cross midnight UTC)
const [sy, sm, sd] = festival.startDate.split("-").map(Number);
const [ey, em, ed] = festival.endDate.split("-").map(Number);
const start = new Date(Date.UTC(sy, sm - 1, sd, 12, 0, 0));
const end   = new Date(Date.UTC(ey, em - 1, ed, 12, 0, 0));

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

const formatDateShort = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric" });

const eventDateStr =
  start.getFullYear() === end.getFullYear() && start.getMonth() === end.getMonth()
    ? `${formatDateShort(start)} – ${end.toLocaleDateString("en-US", { day: "numeric" })}, ${start.getFullYear()}`
    : `${formatDateShort(start)} – ${formatDate(end)}`;

---

<style>
  .frow-meta{display:flex;flex-direction:column;align-items:flex-end;gap:5px}
  .festival-entry {
    padding: 20px 0 18px;
  }

  .festival-entry.live {
    background: #1a0a0a;
    border: 1px solid #3a1010;
    border-radius: 6px;
    padding: 20px;
  }

  .festival-entry.live .countdown {
    color: #f87171;
    animation: pulse 1.4s infinite;
  }

  .festival-entry.has-image {
    background-size: cover;
    background-position: center;
    border-radius: 6px;
    padding: 20px;
    position: relative;
    min-height: 180px;
  }

  .festival-entry.has-image::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
  }

  .festival-entry.has-image > * {
    position: relative;
  }

  .festival-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 6px;
  }


  .festival-name {
    font-size: 18px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .festival-name a {
    color: #fff;
    text-decoration: none;
    text-shadow:
      0 0 8px rgba(0,0,0,0.9),
      0 1px 3px rgba(0,0,0,0.9),
      0 2px 12px rgba(0,0,0,0.7);
  }

  .festival-name a:hover { text-decoration: underline; }

  .festival-entry.live .festival-name {
    font-size: 20px;
    letter-spacing: -0.3px;
  }

  .festival-entry.live .festival-name a {
    color: #fff;
    text-shadow:
      0 0 12px rgba(239, 68, 68, 0.6),
      0 0 24px rgba(239, 68, 68, 0.3),
      0 1px 3px rgba(0,0,0,0.9);
  }

  .ext-icon {
    font-size: 11px;
    color: #aaa;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
  }

  .countdown-wrap {
    text-align: right;
    flex-shrink: 0;
  }

  .countdown {
    font-family: 'Courier New', Courier, monospace;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    text-shadow: 0 0 8px rgba(0,0,0,0.9), 0 1px 3px rgba(0,0,0,0.9);
  }

  .countdown-label {
    font-size: 10px;
    color: #ccc;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
  }

  .festival-meta {
    font-size: 12px;
    color: #ddd;
    margin-bottom: 4px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
  }

  .festival-description {
    font-size: 12px;
    color: #bbb;
    margin-bottom: 8px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
  }

  .festival-dates {
    font-size: 13px;
    color: #eee;
    margin-bottom: 4px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.8);
  }

  .festival-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
  }

  .detail-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px solid #444;
    color: #bbb;
    background: rgba(0,0,0,0.35);
  }

  .ticket-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }

  .ticket-link {
    font-size: 11px;
    padding: 2px 9px;
    border-radius: 3px;
    border: 1px solid #2d6aa0;
    color: #7ec8e3;
    background: #0d1f2d;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .ticket-link:hover {
    background: #1e3a5f;
    color: #b3e0f2;
    text-decoration: none;
  }

  .status-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
  }

  .status-UPCOMING {
    background: #0d2a1a;
    color: #4ade80;
    border: 1px solid #166534;
  }

  .status-LIVE {
    background: #1a0a0a;
    color: #f87171;
    border: 1px solid #7f1d1d;
    animation: pulse 1.4s infinite;
  }

  .status-ENDED {
    background: #1a1a1a;
    color: #999999;
    border: 1px solid #333;
  }

  .free-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 3px;
    background: #0d2a2a;
    color: #34d399;
    border: 1px solid #065f46;
  }

  .festival-entry.ended .festival-name a,
  .festival-entry.ended .countdown { color: #999999; }

  .festival-entry.ended .festival-meta,
  .festival-entry.ended .festival-dates { color: #3a3a3a; }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .divider {
    border: none;
    border-top: 1px solid #2e2e2e;
    margin: 5px 0;
  }

  .eco-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 7px;
    border-radius: 3px;
    text-decoration: none;
  }
  .eco-badge:hover { opacity: 0.8; text-decoration: none; }
  .eco-A { background: #0d2a0d; color: #4ade80; border: 1px solid #166534; }
  .eco-B { background: #1a2a08; color: #a3e635; border: 1px solid #365314; }
  .eco-C { background: #2a1f00; color: #facc15; border: 1px solid #78350f; }
  .eco-D { background: #2a1200; color: #fb923c; border: 1px solid #7c2d12; }
  .eco-F { background: #2a0000; color: #f87171; border: 1px solid #7f1d1d; }
</style>

<div
  class={`festival-entry${status === "ENDED" ? " ended" : ""}${status === "LIVE" ? " live" : ""}${(festival.image && status !== "ENDED") ? " has-image" : ""}`}
  data-name={festival.name ?? ""}
  data-type={festival.type ?? ""}
  data-details={(festival.details ?? []).join(",")}
  data-country={festival.country ?? ""}
  data-eco-grade={ecoGrade ?? ""}
  data-bg={(!eager && festival.image && status !== "ENDED") ? festival.image : undefined}
  data-bg-eager={(eager && festival.image && status !== "ENDED") ? festival.image : undefined}
>
  <div class="festival-header">
    <div class="festival-name">
      <a href={festival.website} target="_blank" rel="noopener noreferrer">
        {festival.name}
      </a>
      <span class="ext-icon">↗</span>
    </div>

    <div class="countdown-wrap">
      <div class="countdown-label">
        <span class="t-en">{status === "ENDED" ? "ended" : status === "LIVE" ? "ends in" : "starts in"}</span>
        <span class="t-fr">{status === "ENDED" ? "terminé" : status === "LIVE" ? "se termine dans" : "commence dans"}</span>
        <span class="t-kr">{status === "ENDED" ? "fini" : status === "LIVE" ? "ka fini adan" : "ka koumansé adan"}</span>
        <span class="t-es">{status === "ENDED" ? "terminado" : status === "LIVE" ? "termina en" : "empieza en"}</span>
      </div>
      <div class="countdown" data-date={countdownTarget}>
        {status === "ENDED" ? "—" : "Loading..."}
      </div>
    </div>
  </div>

  <div class="festival-description">{festival.description}</div>

  <div class="festival-dates">{eventDateStr}</div>

  <div class="festival-meta">{festival.city ? `${festival.city}, ${festival.country}` : festival.country}</div>

  <div class="ticket-links">
    {festival.tickets?.filter((t: { name: string; url: string }) => t.name).length > 0 ? (
      festival.tickets.filter((t: { name: string; url: string }) => t.name).map((t: { name: string; url: string }) => (
        <a class="ticket-link" href={t.url} target="_blank" rel="noopener noreferrer">
          {t.name}
        </a>
      ))
    ) : (
      <span class="free-badge">
        <span class="t-en">Free</span>
        <span class="t-fr">Gratuit</span>
        <span class="t-kr">Gratis</span>
        <span class="t-es">Gratis</span>
      </span>
    )}
  </div>

  <div class="festival-footer">
    <span class={`status-badge status-${status}`}>
      <span class="t-en">{status}</span>
      <span class="t-fr">{status === "UPCOMING" ? "À VENIR" : status === "LIVE" ? "EN COURS" : "TERMINÉ"}</span>
      <span class="t-kr">{status === "UPCOMING" ? "TALÈ" : status === "LIVE" ? "AN KOU" : "FINI"}</span>
      <span class="t-es">{status === "UPCOMING" ? "PRÓXIMO" : status === "LIVE" ? "EN VIVO" : "TERMINADO"}</span>
    </span>
    <div class="frow-meta">
      {ecoGrade && (
        <a href="/sustainability" class={`eco-badge eco-${ecoGrade}`}>♻️ {ecoGrade}</a>
      )}
      {festival.details?.filter((v: string) => v).length > 0 && (
        <div class="detail-tags">
          {festival.details.filter((v: string) => v).map((g: string) => (
            <span class="detail-tag">{g}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</div>

<hr class="divider" />
